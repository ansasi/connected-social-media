{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": ["./**/*.js", "./**/*.ts", "./**/*.tsx"],
  "exclude": ["./dist", "./node_modules", "./.sanity"]
}
